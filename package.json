{
  "name": "nexus-messenger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexus — lightweight self-hosted messenger MVP",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "node --watch server/src/server.js",
    "start": "node server/src/server.js",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:dev": "prisma migrate dev --schema server/prisma/schema.prisma",
    "test": "node --test",
    "test:integration": "RUN_INTEGRATION_TESTS=1 node --test server/tests/*.integration.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "file-type": "21.1.1",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "socket.io": "4.8.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4"
  }
}
