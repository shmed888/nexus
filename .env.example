# Copy to .env and edit. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://nexus:nexus_local_only@localhost:5432/nexus?schema=public
# In production generate a long random value. Not used for password hashing.
APP_SECRET=replace-with-at-least-32-random-characters
# Leave empty for local dev. For deployment, use a full HTTPS origin.
PUBLIC_ORIGIN=http://127.0.0.1:3000
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=./server/data/uploads
SESSION_DAYS=14
STUN_URL=stun:stun.l.google.com:19302
# Optional TURN server for networks where STUN is insufficient.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
